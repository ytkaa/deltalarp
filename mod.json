{
    // The ID of your project. Should be unique!!
    "id": "deltalarp_true",
    // Displays on the main menu.
    "name": "DELTALARP Chapter 1",
    // Displays underneath the name. Optional.
    "subtitle": "THE START",

    // The version of your project.
    "version": "v1.0.0",
    // What version of the engine your project was made with.
    "engineVer": "v0.11.0-dev",

    // The Deltarune chapter you'd like to base your project off of.
    // Do keep in mind that you can control chapter-specific features
    // one by one using the config below.
    "chapter": 1,

    // The map that you start in when first starting the project.
    "map": "chapter1/intro",

    // The party. The first character is the player.
    "party": ["vess"],

    // The inventory. Contains three darkburgers, a cell phone and a shadow crystal by default.
    "inventory": {
    //    "items": [""],
        "key_items": ["drivers_license"]
    },

    // Equipment for your party. Not specifying equipment defaults to the following.
    "equipment": {
        "vess": {
            "weapon": "car_keys"
            
        }
    },

    // Should never be true, but just in case. Restarts the entire engine when leaving the project.
    // If you need this, you're most likely doing something wrong.
    "hardReset": false,

    // Whether the project is hidden from the project selection.
    "hidden": false,

    // Whether the game window's title should be set to the project's name, and the icon to the image
    // in the file `window_icon.png`.
    // When your project is configured as the engine's target project, it's automatically done unless if
    // this option is explicitly set to false; else, it's done if this is set to true.
    "setWindowTitleAndIcon": true,

    // Config values for the engine and any libraries you may have.
    // These config values can control chapter-specific features as well.
    "config": {
        "kristal": {
            "storageSlots": 12,              // The amount of storage slots in the dark world inventory
			"enableRecruits": true,         // Enable recruit messages and menu
			"recruitsProgressSpaces": false, // Whether the recruits progress in the menu will have spaces between the amounts
			"smallSaveMenu": false,          // Single-file save menu with no storage/recruits options
			"lessEquipments": false,         // Reduces the amount of available weapons and armor slots in the inventory

			"partyActions": true,            // Whether X-Actions appear in spell menu by default

			"growStronger": true,            // Stat increases after defeating an enemy with violence
			"growStrongerChara": "noelle",   // Character to prioritize for the "X became stronger" message

			"susieStyle": 2,                 // Susie chapter style
			"ralseiStyle": 2,                // Ralsei chapter style

			"oldTensionBar": false,          // Style of TP bar
			"oldUIPositions": false,         // Old positions of various UI elements
			"oldGameOver": false,            // The game over screen used in chapter 1
			"oldRudeBuster": false,          // Old Rude Buster damage calculation and effect
			"oldPacify": false,              // Removes the animation from the Pacify spell
			"oldDualHealFormula": false,     // Old Dual Heal amount calculation

			"speechBubble": "cyber",         // Default enemy speech bubble style
			"lightTextboxStyle": "light",    // Textbox style used in the light world (by default)
			"darkTextboxStyle": "dark",      // Textbox style used in the dark world (by default)

			"enemyAuras": true,              // Red glow around overworld enemies

			"mercyMessages": true,           // "+X%" mercy messages
			"mercyBar": true,                // Mercy bar next to hp bar in enemy select
			"enemyBarPercentages": true,     // HP / Mercy bar percentages
			"pacifyGlow": true,              // Pacify (and other spells) glow when enemies are TIRED
			"tiredMessages": true,           // Tired mercy messages
			"awakeMessages": true,           // Awake un-mercy messages
			"checkActDescription": true,     // Whether the "Check" act in battle says "Useless analysis" or not

			"targetSystem": false,           // Whether the target system should be used or not
			"soulInvBetweenWaves": false,    // Whether the soul invulnerability will carry between waves in battles

			"darkCurrency": "Dark Dollars",  // Full currency name for the Dark World
			"darkCurrencyShort": "D$",       // Short currency name for the Dark World

			"lightCurrency": "Money",        // Full currency name for the Light World
			"lightCurrencyShort": "$",       // Short currency name for the Light World
			"tpName": "AP",                  // Name of Tension Points in battles

			"prioritySpareableText": false,  // Whether enemies' spareable text should be prioritized over their tired / low-health text

			"pushBlockInputLock": true,      // Whether to lock the player's input when pushing a block
			"keepTensionAfterBattle": false, // Whether TP should be kept after battle instead of reset
			"overworldSpells": false,        // Whether spells should be usable in the overworld
			"damageUnderflowFix": true,      // When disabled, negative enemy damage heals the enemy and displays a negative damage number
			"darkCandyForm": "darker",       // Whether to use Dark Candy or Darker Candy
			"canTossLightWeapons": false,    // Whether light world weapons can be thrown away
			"newShopSpaceUI": true,          // Whether shops use the newer space display with both inventory and storage space
			"shopSpaceUIFont": "8bit_old",   // The font used for the shop space UI's numbers

			"healthConversion": true,        // Whether to (properly) convert health when switching between light and dark worlds.
			"defaultInvulnTime": 40,         // The default length of invulnerability given to the player when hit by a bullet, in frames. (30 frames = 1 second)
			"newChoicers": true,             // Whether to use the new choicer style or not
			"newSpellCostCalculation": true  // Whether to use the new spell cost calculation or not
        }
    },

    // Whether or not to enable dev mode. Dev mode enables debug keys and the console.
    "dev": true
}